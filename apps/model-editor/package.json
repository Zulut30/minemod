{
  "name": "@mcdev/model-editor",
  "productName": "MineMod Studio",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.renderer.json",
    "test": "node scripts/test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:mcp": "node --experimental-strip-types worker/mcp.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.2",
    "@mcdev/editor-core": "workspace:*",
    "@mcdev/application": "workspace:*",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "vite": "8.3.2"
  }
}
